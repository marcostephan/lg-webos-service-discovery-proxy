# Copy to .env (gitignored) and fill in.

# SSH target for `task deploy` and `task remote:logs`.
SSH_HOST=user@host.example

# Directory on the remote host to sync into.
REMOTE_DIR=~/lgtv-sdp

# Host IP that the container binds 80/443 on. Typically a secondary alias
# on the docker host so the primary IP's 80/443 stay free.
BIND_IP=192.168.0.10

# Base URL used by `task smoke`.
TEST_URL=https://192.168.0.10
